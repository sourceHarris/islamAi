# Copy to backend/.env and provide your own credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hidayah_db
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional alternative provider (used only when GROQ_API_KEY is absent).
GOOGLE_API_KEY=
# Optional external Hadith search.
HADITH_API_KEY=
